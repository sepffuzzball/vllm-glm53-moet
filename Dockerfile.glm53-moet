ARG BASE_IMAGE=vllm/vllm-openai:glm53-flash@sha256:2c6da6c6f16ed15c91e412d896dba13701f25fe1861eaec9ddaa4db34d1d21c4
FROM ${BASE_IMAGE}

# Overlay this source tree's Python files onto the pinned base image. The base
# image supplies the compiled native extensions; because COPY only writes files
# present in vllm/, the base image's .so extensions remain untouched.
COPY vllm/ /usr/local/lib/python3.12/dist-packages/vllm/

# Fail fast if the overlay removed the package directory or the compiled
# native extensions that the pinned base image provides.
RUN set -eu; \
    pkg=/usr/local/lib/python3.12/dist-packages/vllm; \
    if [ ! -d "${pkg}" ]; then \
        echo "error: vLLM package directory missing after overlay: ${pkg}" >&2; \
        exit 1; \
    fi; \
    if ! ls "${pkg}"/_C*.so >/dev/null 2>&1; then \
        echo "error: no vLLM native _C*.so found after overlay in ${pkg}" >&2; \
        exit 1; \
    fi

COPY kernels/cubins-sm120/ /cubit-share/

# Fail the build if any shipped cubin differs from the reviewed artifacts.
RUN cd /cubit-share && sha256sum -c SHA256SUMS

ENV VLLM_MOE_W2_CUBIT_DIR=/cubit-share
